"""
CSV to SQLite Loader
--------------------
Loads a CSV file into a local SQLite database file.
No server, no install — SQLite is built into Python.
"""

import pandas as pd
import sqlite3

# -----------------------------------------------------------------------------
# CONFIG — update these three lines
# -----------------------------------------------------------------------------
CSV_PATH = "data.csv"          # path to your CSV
DB_PATH = "my_data.db"         # SQLite file to create
TABLE_NAME = "my_table"        # table name inside the database
# -----------------------------------------------------------------------------


# 1. Read the CSV
df = pd.read_csv(CSV_PATH)
print(f"Loaded {len(df)} rows and {len(df.columns)} columns")
print(f"Columns: {list(df.columns)}")

# 2. Open (or create) the SQLite database file
conn = sqlite3.connect(DB_PATH)

# 3. Write the DataFrame into a table
df.to_sql(TABLE_NAME, conn, if_exists="replace", index=False)
print(f"Wrote {len(df)} rows to table '{TABLE_NAME}' in {DB_PATH}")

# 4. Verify — count rows and preview
row_count = pd.read_sql(f"SELECT COUNT(*) AS n FROM {TABLE_NAME}", conn)
print(f"\nRow count in database:\n{row_count}")

sample = pd.read_sql(f"SELECT * FROM {TABLE_NAME} LIMIT 5", conn)
print(f"\nFirst 5 rows:\n{sample}")

# 5. Close the connection
conn.close()
print("\nDone.")
