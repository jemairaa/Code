"""
Folder of CSVs → SQLite Databases (with provenance tracking)
-------------------------------------------------------------
Walks a root folder recursively. For every folder that contains CSV files,
creates a SQLite .db file in that folder, with one table per CSV.

Every row in every table gets two extra columns:
  - source_file: path to the CSV relative to ROOT_FOLDER
  - loaded_at:   ISO timestamp of when the row was loaded

Rules:
- One .db per folder at every level (folders without CSVs are skipped)
- Table names = CSV filenames (cleaned: lowercase, underscores)
- Existing .db files are overwritten each run
- CSVs that fail to load are skipped with a warning
"""

import pandas as pd
import sqlite3
import re
from pathlib import Path
from datetime import datetime

# -----------------------------------------------------------------------------
# CONFIG — update this one line
# -----------------------------------------------------------------------------
ROOT_FOLDER = r"C:\Users\648685\BOOZ ALLEN HAMILTON\3D Team - 2 - ATHENA\athena_PACAF_Aug_2025\data"
# -----------------------------------------------------------------------------


def clean_name(name: str) -> str:
    """Make a string safe to use as a SQL table name."""
    name = name.lower()
    name = re.sub(r"[^a-z0-9_]", "_", name)
    name = re.sub(r"_+", "_", name).strip("_")
    if name and name[0].isdigit():
        name = f"t_{name}"
    return name or "unnamed_table"


def load_folder(folder_path: Path, root_path: Path) -> dict:
    """Load all CSVs from a folder (non-recursive) into a SQLite DB in that folder."""
    csv_files = [f for f in folder_path.iterdir()
                 if f.is_file() and f.suffix.lower() == ".csv"]

    if not csv_files:
        return {"folder": str(folder_path), "skipped_no_csvs": True}

    db_name = clean_name(folder_path.name) + ".db"
    db_path = folder_path / db_name

    if db_path.exists():
        db_path.unlink()
        print(f"   🗑️  Removed existing {db_name}")

    conn = sqlite3.connect(db_path)
    loaded, failed = [], []

    # Single timestamp for this run, so all rows from the same run match exactly
    load_timestamp = datetime.now().isoformat(timespec="seconds")

    for csv_file in csv_files:
        table_name = clean_name(csv_file.stem)
        try:
            df = pd.read_csv(csv_file)

            # Compute relative path from ROOT_FOLDER for provenance
            try:
                rel_path = str(csv_file.relative_to(root_path))
            except ValueError:
                rel_path = str(csv_file)  # fallback if not under root

            # Add provenance columns at the END so original columns stay aligned
            df["source_file"] = rel_path
            df["loaded_at"] = load_timestamp

            df.to_sql(table_name, conn, if_exists="replace", index=False)
            loaded.append((table_name, len(df), len(df.columns)))
            print(f"   ✅ {csv_file.name} → table '{table_name}' "
                  f"({len(df):,} rows, {len(df.columns) - 2} data cols + 2 provenance)")
        except Exception as e:
            failed.append((csv_file.name, str(e)))
            print(f"   ❌ {csv_file.name} — SKIPPED: {e}")

    conn.close()
    return {
        "folder": str(folder_path),
        "db_path": str(db_path),
        "loaded": loaded,
        "failed": failed,
    }


def main():
    root = Path(ROOT_FOLDER)

    if not root.exists():
        print(f"❌ Folder not found: {root}")
        return
    if not root.is_dir():
        print(f"❌ Not a folder: {root}")
        return

    print(f"🔍 Scanning {root} recursively...\n")

    all_folders = [root] + [p for p in root.rglob("*") if p.is_dir()]

    results = []
    for folder in all_folders:
        has_csvs = any(f.suffix.lower() == ".csv"
                       for f in folder.iterdir() if f.is_file())
        if not has_csvs:
            continue

        rel = folder.relative_to(root) if folder != root else Path(".")
        print(f"📁 {rel}")
        result = load_folder(folder, root)
        results.append(result)
        print()

    # ---------------- Summary ----------------
    print("=" * 60)
    print("SUMMARY")
    print("=" * 60)
    total_loaded = sum(len(r.get("loaded", [])) for r in results)
    total_failed = sum(len(r.get("failed", [])) for r in results)
    print(f"Databases created: {len(results)}")
    print(f"Tables loaded:     {total_loaded}")
    print(f"Files skipped:     {total_failed}")
    print(f"\nEvery table now has these extra columns:")
    print(f"   - source_file (relative path to original CSV)")
    print(f"   - loaded_at   (ISO timestamp of this run)")

    if total_failed > 0:
        print("\nSkipped files:")
        for r in results:
            for fname, err in r.get("failed", []):
                print(f"   - {r['folder']}\\{fname}: {err}")


if __name__ == "__main__":
    main()
