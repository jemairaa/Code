class ScriptInfo:
    def __init__(self, path: Path):
        self.path = path
        self.name = path.name
        self.source = ""
        self.line_count = 0
        self.docstring: Optional[str] = None
        self.constants: dict[str, str] = {}
        self.imports: list[str] = []
        self.files_read: list[str] = []
        self.files_written: list[str] = []
        self.functions: list[dict] = []
        self.section_comments: list[str] = []
        self.todos: list[str] = []
        # five-part content
        self.calculations: list[str] = []      # detected math, plain descriptions
        self.shaping: dict[str, int] = {}      # label -> count
        self.merges: list[str] = []            # human-readable merge descriptions
        # filled by LLM pass (optional)
        self.llm_purpose: str = ""
        self.llm_calc_prose: str = ""
        self.llm_shaping_prose: str = ""
        # code-health (v8) — all deterministic, computed from the AST
        self.health: dict = {}  # metrics: loc, sloc, comments, functions,
                                # max_complexity, complex_funcs, long_funcs,
                                # maintainability, deep_nesting, etc.
        # deliverable/onboarding prose (v9, optional, LLM-filled)
        self.deliv_plain: str = ""   # plain-language "what & why"
        self.deliv_inout: str = ""   # plain-language "what goes in/out"
        self.deliv_watch: str = ""   # plain-language "what to watch for"
        # deliverable/onboarding prose (v9) — plain language, no jargon
        self.deliv_plain: str = ""   # what it does + why it matters
        self.deliv_inout: str = ""   # what goes in / comes out, in plain terms
        self.deliv_watch: str = ""   # what a new analyst should watch for


# ---------- AST path-resolution engine (shared with v2-v6) ----------

def resolve_string(node, constants: dict[str, str]) -> Optional[str]:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    if isinstance(node, ast.Name):
        return constants.get(node.id)
    if isinstance(node, ast.JoinedStr):
        pieces = []
        for value in node.values:
            if isinstance(value, ast.Constant) and isinstance(value.value, str):
                pieces.append(value.value)
            elif isinstance(value, ast.FormattedValue):
                inner = resolve_string(value.value, constants)
                if inner is None:
                    return None
                pieces.append(inner)
            else:
                return None
        return "".join(pieces)
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
        left = resolve_string(node.left, constants)
        right = resolve_string(node.right, constants)
        if left is not None and right is not None:
            return left + right
        return None
    return None


def looks_like_path(s: str) -> bool:
    if not s or len(s) > 300:
        return False
    if "/" in s or "\\" in s:
        return True
    return bool(re.search(r"\.\w{1,6}$", s))


def collect_constants(tree: ast.AST) -> dict[str, str]:
    constants: dict[str, str] = {}
    if not isinstance(tree, ast.Module):
        return constants
    for node in tree.body:
        if isinstance(node, ast.Assign):
            value = resolve_string(node.value, constants)
            if value is None:
                continue
            for target in node.targets:
                if isinstance(target, ast.Name):
                    constants[target.id] = value
    return constants


def collect_path_arg(call_node, constants: dict[str, str]) -> Optional[str]:
    if call_node.args:
        candidate = resolve_string(call_node.args[0], constants)
        if candidate and looks_like_path(candidate):
            return candidate
    for kw in call_node.keywords:
        if kw.arg in {"path", "filepath", "filename", "file", "io", "buf"}:
            candidate = resolve_string(kw.value, constants)
            if candidate and looks_like_path(candidate):
                return candidate
    return None


# ---------- Section comments + TODOs ----------

def extract_comments(source: str) -> tuple[list[str], list[str]]:
    comments: list[str] = []
    todos: list[str] = []
    todo_pattern = re.compile(r"\b(todo|fixme|hack|xxx|need to|figure out|not yet)\b", re.I)
    try:
        tokens = tokenize.generate_tokens(io.StringIO(source).readline)
        for tok in tokens:
            if tok.type == tokenize.COMMENT:
                start_col = tok.start[1]
                text = tok.string.lstrip("#").strip()
                if not text:
                    continue
                if todo_pattern.search(text):
                    todos.append(text)
                    continue
                if re.match(r"^[A-Za-z_][\w\.]*\s*[=\(\[]", text):
                    continue
                if re.match(r"^(import|from|def|class|return|if|for|while|print)\b", text):
                    continue
                if len(text) > 90:
                    continue
                if start_col <= 8:
                    comments.append(text)
    except (tokenize.TokenError, IndentationError):
        pass
    return comments, todos


# ---------- Merge description ----------

def describe_merge(call_node, constants: dict[str, str]) -> Optional[str]:
    func = call_node.func
    attr = func.attr if isinstance(func, ast.Attribute) else None
    if attr not in {"merge", "join", "merge_asof"}:
        return None
    left = ""
    if isinstance(func, ast.Attribute) and isinstance(func.value, ast.Name):
        left = func.value.id
    right = ""
    if call_node.args and isinstance(call_node.args[0], ast.Name):
        right = call_node.args[0].id
    on = None
    how = None
    for kw in call_node.keywords:
        if kw.arg in {"on", "left_on", "right_on"} and isinstance(kw.value, ast.Constant):
            on = kw.value.value
        if kw.arg == "how" and isinstance(kw.value, ast.Constant):
            how = kw.value.value
    parts = []
    if left and right:
        parts.append(f"`{left}` + `{right}`")
    elif right:
        parts.append(f"join with `{right}`")
    if on:
        parts.append(f"on `{on}`")
    if how:
        parts.append(f"({how})")
    return " ".join(parts) if parts else None


# ---------- Calculation detection ----------

def _unparse(node) -> str:
    try:
        return ast.unparse(node)
    except Exception:
        return "<expr>"


def _column_name(node) -> Optional[str]:
    """If node is df['col'] style subscript, return 'col'."""
    if isinstance(node, ast.Subscript):
        sl = node.slice
        if isinstance(sl, ast.Constant) and isinstance(sl.value, str):
            return sl.value
    return None


def _numeric_constants_in(node) -> list[str]:
    found = []
    for n in ast.walk(node):
        if isinstance(n, ast.Constant) and isinstance(n.value, (int, float)):
            found.append(repr(n.value))
    return found


def detect_calculations(tree: ast.AST) -> list[str]:
    """
    Walk the AST and surface mathematical operations in plain language:
      * arithmetic assigned to a dataframe column
      * np.where conditional replacement
      * np.sin / cos / radians (trig)
      * groupby().sum()/mean()/etc aggregations
      * .apply() with a function (row-wise calculation)
      * numeric constants that match known unit conversions
    """
    calcs: list[str] = []

    for node in ast.walk(tree):
        # --- arithmetic assigned to something (esp. a df column) ---
        if isinstance(node, ast.Assign) and isinstance(node.value, ast.BinOp):
            op = node.value.op
            op_name = {
                ast.Add: "+", ast.Sub: "-", ast.Mult: "×",
                ast.Div: "/", ast.Pow: "^", ast.Mod: "%",
            }.get(type(op))
            if op_name is None:
                continue
            # only care about numeric-ish arithmetic, skip string concat we can't tell
            target_desc = ""
            if node.targets:
                tgt = node.targets[0]
                col = _column_name(tgt)
                if col:
                    target_desc = f"`{col}` = "
                elif isinstance(tgt, ast.Name):
                    target_desc = f"`{tgt.id}` = "
            expr = _unparse(node.value)
            if len(expr) > 120:
                expr = expr[:117] + "..."
            line = f"computes {target_desc}`{expr}`"
            # annotate known unit-conversion constants
            consts = _numeric_constants_in(node.value)
            is_known_conversion = False
            for c in consts:
                key = c.rstrip("0").rstrip(".") if "." in c else c
                for known, meaning in KNOWN_CONSTANTS.items():
                    if c == known or key == known.rstrip("0").rstrip("."):
                        line += f" — {meaning}"
                        is_known_conversion = True
                        break
            # annotate percentage scaling ONLY for a literal fraction 0 < n < 1
            # (e.g. x * 0.9 -> "scales to 90%"), and only when the constant
            # isn't already a recognized unit conversion. Plain multipliers
            # like 80 are NOT percentages and get no annotation.
            if isinstance(op, ast.Mult) and not is_known_conversion:
                for side in (node.value.left, node.value.right):
                    if isinstance(side, ast.Constant) and isinstance(side.value, float):
                        v = side.value
                        if 0 < v < 1:
                            pct = round(v * 100, 4)
                            reduction = round(100 - pct, 4)
                            pct_s = f"{pct:g}"
                            red_s = f"{reduction:g}"
                            line += (f" — scales to {pct_s}% of the original "
                                     f"(a {red_s}% reduction)")
                            break
            calcs.append(line)

        # --- AugAssign (x += ...) ---
        elif isinstance(node, ast.AugAssign) and not isinstance(node.value, ast.Constant):
            op_name = {
                ast.Add: "+=", ast.Sub: "-=", ast.Mult: "×=", ast.Div: "/=",
            }.get(type(node.op))
            if op_name:
                col = _column_name(node.target)
                tgt = f"`{col}`" if col else (
                    f"`{node.target.id}`" if isinstance(node.target, ast.Name) else "value"
                )
                calcs.append(f"updates {tgt} with `{op_name} {_unparse(node.value)[:80]}`")

        # --- function calls: np.where, trig, groupby aggs, apply ---
        elif isinstance(node, ast.Call):
            func = node.func
            # np.where
            if isinstance(func, ast.Attribute) and func.attr == "where":
                cond = _unparse(node.args[0]) if node.args else ""
                if len(cond) > 80:
                    cond = cond[:77] + "..."
                calcs.append(f"conditional replace via `np.where({cond} ...)`")
            # trig / radians
            if isinstance(func, ast.Attribute) and func.attr in {"sin", "cos", "tan", "radians", "degrees"}:
                calcs.append(f"trigonometric: `{func.attr}(...)`")
            # groupby aggregation: look for .groupby(...).agg-ish chains
            if isinstance(func, ast.Attribute) and func.attr in {
                "sum", "mean", "median", "min", "max", "count", "std", "agg"
            }:
                # is the thing it's called on a groupby?
                inner = func.value
                chain = _unparse(inner)
                if "groupby" in chain:
                    calcs.append(f"aggregation: `{chain}.{func.attr}()`")
            # .apply with a function argument
            if isinstance(func, ast.Attribute) and func.attr == "apply":
                if node.args and isinstance(node.args[0], ast.Name):
                    calcs.append(f"row/column-wise calculation: `.apply({node.args[0].id})`")
                elif node.args and isinstance(node.args[0], ast.Lambda):
                    calcs.append("row/column-wise calculation: `.apply(lambda ...)`")
            # round()
            if isinstance(func, ast.Name) and func.id == "round":
                pass  # too noisy to list every round()

    # dedupe preserving order
    seen = set()
    return [c for c in calcs if not (c in seen or seen.add(c))]


# ---------- Whole-script analysis ----------

def analyze_script(path: Path) -> ScriptInfo:
    info = ScriptInfo(path)
    source = path.read_text(encoding="utf-8", errors="replace")
    info.source = source
    info.line_count = source.count("\n") + 1
    info.section_comments, info.todos = extract_comments(source)

    try:
        tree = ast.parse(source, filename=str(path))
    except SyntaxError as e:
        info.docstring = f"(could not parse: {e})"
        return info

    info.docstring = ast.get_docstring(tree)
    info.constants = collect_constants(tree)

    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                info.imports.append(alias.name.split(".")[0])
        elif isinstance(node, ast.ImportFrom):
            if node.module:
                info.imports.append(node.module.split(".")[0])
        elif isinstance(node, ast.Call):
            func = node.func
            attr = func.attr if isinstance(func, ast.Attribute) else None
            if attr in READ_FUNCS:
                resolved = collect_path_arg(node, info.constants)
                if resolved:
                    info.files_read.append(resolved)
            elif attr in WRITE_FUNCS:
                resolved = collect_path_arg(node, info.constants)
                if resolved:
                    info.files_written.append(resolved)
            if isinstance(func, ast.Name) and func.id == "open":
                resolved = collect_path_arg(node, info.constants)
                if resolved:
                    mode = "r"
                    if len(node.args) > 1:
                        m = resolve_string(node.args[1], info.constants)
                        if m:
                            mode = m
                    if any(c in mode for c in "wax"):
                        info.files_written.append(resolved)
                    else:
                        info.files_read.append(resolved)
            # shaping ops
            if attr in SHAPING_LABELS:
                label = SHAPING_LABELS[attr]
                info.shaping[label] = info.shaping.get(label, 0) + 1
            # merges
            mdesc = describe_merge(node, info.constants)
            if mdesc:
                info.merges.append(mdesc)

    # functions
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            info.functions.append({
                "name": node.name,
                "args": [a.arg for a in node.args.args],
                "docstring": ast.get_docstring(node),
            })

    # calculations
    info.calculations = detect_calculations(tree)

    def dedupe(seq):
        seen = set()
        return [x for x in seq if not (x in seen or seen.add(x))]

    info.imports = dedupe(info.imports)
    info.files_read = dedupe(info.files_read)
    info.files_written = dedupe(info.files_written)
    info.merges = dedupe(info.merges)

    # code-health metrics (deterministic, no external deps required)
    info.health = compute_health(tree, info.source)
    return info


# ---------- Code-health analysis (v8, deterministic) ----------

def _cyclomatic_complexity(func_node) -> int:
    """
    McCabe cyclomatic complexity for a function: 1 + number of decision points.
    Counts if/elif, for, while, except, with, boolean and/or, comprehension
    conditions, ternary expressions. This is the same idea radon uses; we
    compute it natively so v8 needs no extra install.
    """
    complexity = 1
    for n in ast.walk(func_node):
        if isinstance(n, (ast.If, ast.For, ast.AsyncFor, ast.While)):
            complexity += 1
        elif isinstance(n, ast.ExceptHandler):
            complexity += 1
        elif isinstance(n, ast.BoolOp):
            # each extra operand in an and/or chain is a branch
            complexity += max(0, len(n.values) - 1)
        elif isinstance(n, ast.IfExp):  # ternary
            complexity += 1
        elif isinstance(n, ast.comprehension):
            complexity += 1 + len(n.ifs)
    return complexity


def _max_nesting_depth(func_node) -> int:
    """Deepest level of nested control structures inside a function."""
    nesting_types = (ast.If, ast.For, ast.AsyncFor, ast.While, ast.With,
                     ast.AsyncWith, ast.Try)

    def depth(node, current=0):
        best = current
        for child in ast.iter_child_nodes(node):
            if isinstance(child, nesting_types):
                best = max(best, depth(child, current + 1))
            else:
                best = max(best, depth(child, current))
        return best

    return depth(func_node, 0)


def compute_health(tree: ast.AST, source: str) -> dict:
    """
    Produce a deterministic 'code health' snapshot for one script:
      - line counts (total, code, comment, blank)
      - per-function cyclomatic complexity and length
      - flags for overly complex / very long / deeply nested functions
      - a simple maintainability band (good / moderate / needs attention)
    Uses radon for a maintainability index if it happens to be installed;
    otherwise derives a comparable band natively.
    """
    lines = source.splitlines()
    total = len(lines)
    blank = sum(1 for l in lines if not l.strip())
    comment = sum(1 for l in lines if l.strip().startswith("#"))
    code_lines = total - blank - comment

    funcs = []
    for node in ast.walk(tree):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            start = node.lineno
            end = max(
                [start] + [getattr(c, "end_lineno", start) or start
                           for c in ast.walk(node)]
            )
            length = end - start + 1
            cc = _cyclomatic_complexity(node)
            nest = _max_nesting_depth(node)
            funcs.append({
                "name": node.name, "length": length,
                "complexity": cc, "nesting": nest, "lineno": start,
            })

    max_cc = max((f["complexity"] for f in funcs), default=0)
    max_len = max((f["length"] for f in funcs), default=0)
    max_nest = max((f["nesting"] for f in funcs), default=0)

    complex_funcs = sorted(
        [f for f in funcs if f["complexity"] >= 10],
        key=lambda f: -f["complexity"],
    )
    long_funcs = sorted(
        [f for f in funcs if f["length"] >= 60],
        key=lambda f: -f["length"],
    )
    deep_funcs = sorted(
        [f for f in funcs if f["nesting"] >= 4],
        key=lambda f: -f["nesting"],
    )

    # Optional: radon maintainability index, if installed. Never required.
    mi_score = None
    try:
        from radon.metrics import mi_visit  # type: ignore
        mi_score = round(mi_visit(source, multi=True), 1)
    except Exception:
        mi_score = None

    # Native maintainability band when radon isn't present (or to summarize MI)
    if mi_score is not None:
        if mi_score >= 20:
            band = "good"
        elif mi_score >= 10:
            band = "moderate"
        else:
            band = "needs attention"
    else:
        # derive a band from our own signals
        if max_cc >= 15 or max_len >= 120 or max_nest >= 5:
            band = "needs attention"
        elif max_cc >= 8 or max_len >= 60 or max_nest >= 4:
            band = "moderate"
        else:
            band = "good"

    comment_ratio = round(comment / total * 100, 1) if total else 0.0

    return {
        "total_lines": total,
        "code_lines": code_lines,
        "comment_lines": comment,
        "blank_lines": blank,
        "comment_ratio": comment_ratio,
        "function_count": len(funcs),
        "max_complexity": max_cc,
        "max_function_length": max_len,
        "max_nesting": max_nest,
        "complex_functions": complex_funcs[:5],
        "long_functions": long_funcs[:5],
        "deep_functions": deep_funcs[:5],
        "maintainability_index": mi_score,
        "maintainability_band": band,
    }

OLLAMA_URL = "http://localhost:11434/api/generate"


def ollama_available() -> bool:
    """Quick check: is a local Ollama server reachable?"""
    try:
        req = urllib.request.Request("http://localhost:11434/api/tags", method="GET")
        with urllib.request.urlopen(req, timeout=3) as resp:
            return resp.status == 200
    except Exception:
        return False


def ollama_generate(model: str, prompt: str, timeout: int = 180,
                    json_mode: bool = False) -> Optional[str]:
    """
    Call the local Ollama server. Returns the response text, or None on failure.

    When `json_mode=True`, asks Ollama to constrain output to valid JSON
    (Ollama's `format: 'json'`). This is what makes deliverable mode reliable
    on small local models — we get parseable JSON instead of free-form prose
    in whatever shape the model felt like.
    """
    body = {
        "model": model,
        "prompt": prompt,
        "stream": False,
        "options": {"temperature": 0.2, "num_predict": 1024},
    }
    if json_mode:
        body["format"] = "json"
    payload = json.dumps(body).encode("utf-8")
    try:
        req = urllib.request.Request(
            OLLAMA_URL, data=payload,
            headers={"Content-Type": "application/json"}, method="POST",
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data.get("response", "").strip()
    except Exception:
        return None


def build_llm_prompt(info: ScriptInfo) -> str:
    """
    Build a grounded prompt: give the model the structured facts v7 already
    extracted PLUS the source, and ask for prose. Grounding in extracted facts
    keeps a small local model from hallucinating.
    """
    facts = []
    facts.append(f"Script name: {info.name}")
    if info.files_read:
        facts.append("Reads files: " + ", ".join(Path(f).name for f in info.files_read))
    if info.files_written:
        facts.append("Writes files: " + ", ".join(Path(f).name for f in info.files_written))
    if info.merges:
        facts.append("Merges/joins detected: " + "; ".join(info.merges))
    if info.calculations:
        facts.append("Calculations detected:\n  - " + "\n  - ".join(info.calculations))
    if info.shaping:
        facts.append("Shaping operations: " + ", ".join(
            f"{k} (x{v})" for k, v in sorted(info.shaping.items(), key=lambda kv: -kv[1])
        ))
    if info.section_comments:
        facts.append("Section comments in order:\n  - " + "\n  - ".join(info.section_comments))

    facts_block = "\n".join(facts)

    # Trim source so the prompt stays manageable for small local models
    src = info.source
    if len(src) > 8000:
        src = src[:8000] + "\n# ... (truncated for length) ..."

    return f"""You are documenting a Python data-pipeline script for a team.

Below are FACTS already extracted from the script by static analysis, followed
by the script's SOURCE CODE. Use the facts as ground truth; use the source for
detail. Do not invent file names or operations not present.

=== EXTRACTED FACTS ===
{facts_block}

=== SOURCE CODE ===
{src}

=== YOUR TASK ===
Respond in exactly this format, nothing else:

PURPOSE: <one plain-English sentence: what this script does and why it exists in the pipeline>

CALCULATIONS: <2-4 sentences explaining the mathematical calculations in plain English. If a numeric constant is a unit conversion, say so. For multiplication by a fraction (e.g. x * 0.9), describe it precisely as "scaled to 90% of the original" or "reduced by 10%" — never use the word "discount". If there are no real calculations, write "No significant mathematical calculations - this script is data shaping only.">

SHAPING: <2-4 sentences explaining how the script reshapes/combines/filters data, in plain English>
"""


def build_deliverable_prompt(info: ScriptInfo) -> str:
    """
    Deliverable/onboarding variant — heavily prompt-engineered for small local
    models. Three changes from earlier versions:
      1. NO source code in the prompt (facts only) — keeps the prompt small
         enough that a 7B model on CPU doesn't time out or return empty.
      2. Few-shot example shows the model what good plain-language output
         looks like; a small model imitates an example more reliably than it
         follows abstract instructions.
      3. The model is told to emit JSON; we call Ollama with format='json' so
         the response is guaranteed parseable.
    """
    facts = []
    facts.append(f"Script name: {info.name}")
    if info.files_read:
        facts.append("Reads (describe what these represent, not file names): "
                     + ", ".join(Path(f).stem.replace('_', ' ')
                                 for f in info.files_read))
    if info.files_written:
        facts.append("Produces: "
                     + ", ".join(Path(f).stem.replace('_', ' ')
                                 for f in info.files_written))
    if info.calculations:
        hints = [c[:200] for c in info.calculations[:6]]
        facts.append("Operations the script performs:\n  - "
                     + "\n  - ".join(hints))
    if info.merges:
        facts.append(f"Number of dataset combinations performed: "
                     f"{len(info.merges)}")
    if info.section_comments:
        # the team's own step comments are the single most useful signal
        facts.append("The team's own step-by-step comments in the script:\n  - "
                     + "\n  - ".join(info.section_comments[:25]))
    if info.todos:
        facts.append("Known issues/TODOs the team flagged:\n  - "
                     + "\n  - ".join(info.todos[:5]))
    facts_block = "\n".join(facts)

    example = """{
  "plain": "This step combines the planned aircraft list with each aircraft's physical dimensions, then works out how much ramp space every airfield needs once everything is parked. It also pulls in fuel, munitions, and hangar information so the final planning file has everything in one place. It matters because the rest of the pipeline depends on this combined picture to decide whether each base can actually support its assigned aircraft.",
  "inout": "It takes the planned aircraft assignments and the supporting reference data (aircraft sizes, fuel inventory, munitions storage, hangar capacity, airfield surveys) and produces the consolidated laydown files that summarize each airfield's situation.",
  "watch": "The team has flagged that duplicate rows are sometimes created for main operating bases - worth double-checking those before relying on totals. The 10% apron reduction for unusable space is a planning assumption, not a measured value."
}"""

    return f"""You are writing ONBOARDING documentation for a new analyst.

Your reader understands the mission and the data, but does NOT read code.
NEVER use code terms (no "merge", "join", "dataframe", "apply", "groupby",
"np.where", function names, or column names like "icao" or "df").
Translate everything into the way you'd brief a teammate on their first day.

Below are the FACTS extracted from one pipeline step. Write three short
plain-language paragraphs about it, returned as JSON with exactly these keys:
  plain  - 2-4 sentences: what this step does and why it matters
  inout  - 1-2 sentences: what goes in and what comes out (describe by meaning)
  watch  - 1-2 sentences: what to be careful of (known issues, assumptions)

=== EXAMPLE OUTPUT (a different aircraft-laydown step) ===
{example}

=== FACTS FOR THE STEP YOU ARE DOCUMENTING ===
{facts_block}

=== YOUR JSON RESPONSE ===
"""


def _parse_labeled_response(text: str, labels: dict[str, str],
                            fallback_key: str) -> dict[str, str]:
    """
    Generic tolerant section parser. `labels` maps output keys to a regex
    alternation for that section's header (e.g. {"purpose": "PURPOSE"}).
    Accepts markdown/bold/numbered/dash variants. If NO labels match, the
    whole reply is kept under `fallback_key` so model output is never lost.
    """
    out = {k: "" for k in labels}
    if not text or not text.strip():
        return out

    text = text.strip()
    text = re.sub(r"^```[a-zA-Z]*\n?", "", text)
    text = re.sub(r"\n?```$", "", text)

    def section_pattern(label: str, others: list[str]) -> str:
        lead = r"(?:^|\n)\s*(?:#{1,6}\s*|\*{1,2}\s*|\d+\.\s*|-\s*)?"
        # wrap the label (which may itself contain alternation) so it can't
        # leak into surrounding regex structure
        name = rf"(?:{label})\s*\*{{0,2}}\s*[:\-\u2013)]*\s*"
        stops = "|".join(f"(?:{o})" for o in (others + [label]))
        stop = rf"(?=\n\s*(?:#{{1,6}}\s*|\*{{1,2}}\s*|\d+\.\s*|-\s*)?(?:{stops})\b|\Z)"
        return lead + name + r"(.+?)" + stop

    found_any = False
    for key, lab in labels.items():
        others = [v for k, v in labels.items() if k != key]
        pat = section_pattern(lab, others)
        m = re.search(pat, text, re.S | re.I)
        if m:
            val = " ".join(m.group(1).split()).strip(" :-\u2013*")
            if val:
                out[key] = val
                found_any = True

    if not found_any:
        out[fallback_key] = " ".join(text.split())[:1200]
    return out


def parse_llm_response(text: str) -> dict[str, str]:
    """Technical prose: PURPOSE / CALCULATIONS / SHAPING (tolerant)."""
    return _parse_labeled_response(
        text,
        {
            "purpose": "PURPOSE",
            "calculations": "CALCULATION(?:S)?",
            "shaping": "(?:DATA[ _]?)?SHAPING",
        },
        fallback_key="purpose",
    )


def parse_deliverable_response(text: str) -> dict[str, str]:
    """
    Onboarding prose parser. The model is called with Ollama's JSON-mode so
    `text` should already be a JSON object with plain/inout/watch keys. Try
    that first; fall back to the tolerant label parser if the model still
    emitted plain prose (e.g. JSON-mode not honoured, older Ollama).
    """
    out = {"plain": "", "inout": "", "watch": ""}
    if not text or not text.strip():
        return out
    t = text.strip()
    # strip code-fence wrappers some models add even in JSON mode
    t = re.sub(r"^```(?:json)?\s*", "", t)
    t = re.sub(r"\s*```$", "", t)
    # try strict JSON first
    candidates = [t]
    # also try extracting the first {...} block in case the model added preamble
    m = re.search(r"\{.*\}", t, re.S)
    if m and m.group(0) != t:
        candidates.append(m.group(0))
    for cand in candidates:
        try:
            obj = json.loads(cand)
            if isinstance(obj, dict):
                for k in ("plain", "inout", "watch"):
                    v = obj.get(k, "")
                    if isinstance(v, str):
                        out[k] = v.strip()
                if any(out.values()):
                    return out
        except Exception:
            continue
    # last-resort: same tolerant prose parser as before
    return _parse_labeled_response(
        text,
        {
            "plain": "PLAIN",
            "inout": "INOUT|IN\\s*[ _/&]\\s*OUT|INPUTS?\\s*[ _/&]?\\s*OUTPUTS?|IN\\s*AND\\s*OUT",
            "watch": "WATCH|WATCH[ _]?OUT|CAUTION|GOTCHAS?",
        },
        fallback_key="plain",
    )


# ---------- LLM cache ----------

def script_hash(info: ScriptInfo) -> str:
    return hashlib.sha256(info.source.encode("utf-8")).hexdigest()[:16]


def load_cache(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def save_cache(path: Path, cache: dict) -> None:
    try:
        path.write_text(json.dumps(cache, indent=2), encoding="utf-8")
    except Exception:
        pass


def run_llm_pass(scripts: list[ScriptInfo], model: str, cache_path: Path,
                 deliverable: bool = False) -> int:
    """
    For each script, get LLM prose (from cache if the script is unchanged,
    otherwise by calling Ollama). Returns the number of scripts the model
    actually ran on (cache misses).

    When `deliverable` is True, generates plain-language onboarding prose
    (PLAIN/INOUT/WATCH) instead of the technical prose, using a distinct
    cache key so the two prose styles never collide in the cache.
    """
    cache = load_cache(cache_path)
    calls_made = 0
    for info in scripts:
        h = script_hash(info)
        mode_tag = "deliv" if deliverable else "tech"
        cache_key = f"{info.name}:{h}:{model}:{mode_tag}"
        if cache_key in cache:
            cached = cache[cache_key]
            if deliverable:
                info.deliv_plain = cached.get("plain", "")
                info.deliv_inout = cached.get("inout", "")
                info.deliv_watch = cached.get("watch", "")
            else:
                info.llm_purpose = cached.get("purpose", "")
                info.llm_calc_prose = cached.get("calculations", "")
                info.llm_shaping_prose = cached.get("shaping", "")
            continue
        prompt = (build_deliverable_prompt(info) if deliverable
                  else build_llm_prompt(info))
        print(f"  [LLM] summarizing {info.name} ...", end="", flush=True)
        _t0 = _time.time()
        # deliverable mode: use Ollama's JSON-mode for reliable parsing
        response = ollama_generate(model, prompt, json_mode=deliverable)
        _elapsed = _time.time() - _t0
        print(f" done ({_elapsed:.0f}s, {len(response or '')} chars)", flush=True)
        calls_made += 1
        if deliverable:
            parsed = parse_deliverable_response(response or "")
            info.deliv_plain = parsed["plain"]
            info.deliv_inout = parsed["inout"]
            info.deliv_watch = parsed["watch"]
        else:
            parsed = parse_llm_response(response or "")
            info.llm_purpose = parsed["purpose"]
            info.llm_calc_prose = parsed["calculations"]
            info.llm_shaping_prose = parsed["shaping"]
        # keep the raw response in the cache too, so the parser can be
        # improved later and re-applied WITHOUT re-calling the model
        parsed_with_raw = dict(parsed)
        parsed_with_raw["_raw"] = response or ""
        cache[cache_key] = parsed_with_raw
        save_cache(cache_path, cache)  # save incrementally so a crash doesn't lose work
    return calls_made


# ---------- Markdown rendering ----------

def infer_purpose_fallback(info: ScriptInfo) -> str:
    """Used when no LLM prose is available."""
    stem = re.sub(r"^\d+[_-]?", "", info.name.replace(".py", "")).replace("_", " ").strip()
    bits = [stem.capitalize() if stem else "Pipeline script"]
    if info.files_read:
        bits.append(f"reads {len(info.files_read)} file(s)")
    if info.files_written:
        bits.append(f"writes {len(info.files_written)} file(s)")
    return " — ".join(bits)


def render_script_section(info: ScriptInfo) -> list[str]:
    lines = []
    lines.append(f"## `{info.name}`\n")
    lines.append(f"_{info.line_count} lines · libraries: "
                 + (", ".join(f"`{i}`" for i in info.imports) or "none") + "_\n")

    # 1. Purpose
    lines.append("### 1. Purpose\n")
    if info.llm_purpose:
        lines.append(info.llm_purpose + "\n")
    elif info.docstring:
        lines.append(info.docstring.strip().split("\n")[0] + "\n")
    else:
        lines.append(f"_{infer_purpose_fallback(info)}_  ")
        lines.append("_(run with `--llm` for a written purpose)_\n")

    # 2. Inputs
    lines.append("### 2. Inputs (files read)\n")
    if info.files_read:
        for f in info.files_read:
            lines.append(f"- `{f}`")
    else:
        lines.append("- _None detected._")
    lines.append("")

    # 3. Outputs
    lines.append("### 3. Outputs (files written)\n")
    if info.files_written:
        for f in info.files_written:
            lines.append(f"- `{f}`")
    else:
        lines.append("- _None detected._")
    lines.append("")

    # 4. Calculations
    lines.append("### 4. Calculations (the math)\n")
    if info.llm_calc_prose:
        lines.append(info.llm_calc_prose + "\n")
    if info.calculations:
        lines.append("_Detected operations:_")
        for c in info.calculations:
            lines.append(f"- {c}")
        lines.append("")
    elif not info.llm_calc_prose:
        lines.append("_No mathematical calculations detected — this script is "
                     "data shaping only._\n")

    # 5. Data shaping
    lines.append("### 5. Data shaping\n")
    if info.llm_shaping_prose:
        lines.append(info.llm_shaping_prose + "\n")
    if info.merges:
        lines.append("**Joins / merges:**")
        for m in info.merges:
            lines.append(f"- {m}")
        lines.append("")
    if info.shaping:
        ops = sorted(info.shaping.items(), key=lambda kv: -kv[1])
        lines.append("**Operations:** "
                     + ", ".join(f"{label} ×{count}" for label, count in ops) + "\n")
    if info.section_comments:
        lines.append("**Step outline (from section comments):**")
        for i, c in enumerate(info.section_comments, 1):
            lines.append(f"{i}. {c}")
        lines.append("")
    if not (info.merges or info.shaping or info.section_comments or info.llm_shaping_prose):
        lines.append("_No data-shaping operations detected._\n")

    # Functions
    if info.functions:
        lines.append("**Functions defined:**")
        for fn in info.functions:
            sig = f"`{fn['name']}({', '.join(fn['args'])})`"
            doc = fn["docstring"].strip().split("\n")[0] if fn["docstring"] else ""
            lines.append(f"- {sig}" + (f" — {doc}" if doc else ""))
        lines.append("")

    # Open items
    if info.todos:
        lines.append("### ⚠️ Open items flagged in the code\n")
        for t in info.todos:
            lines.append(f"- {t}")
        lines.append("")

    # Code health (v8)
    h = info.health
    if h:
        band = h["maintainability_band"]
        badge = {"good": "🟢 good",
                 "moderate": "🟡 moderate",
                 "needs attention": "🔴 needs attention"}.get(band, band)
        lines.append("### 🩺 Code health\n")
        lines.append(f"**Maintainability:** {badge}"
                     + (f" (index {h['maintainability_index']})"
                        if h["maintainability_index"] is not None else "")
                     + "\n")
        lines.append(
            f"- {h['code_lines']} code lines, {h['comment_lines']} comment "
            f"lines ({h['comment_ratio']}% comments), "
            f"{h['function_count']} function(s)"
        )
        lines.append(
            f"- Most complex function: cyclomatic complexity "
            f"{h['max_complexity']} · longest function: "
            f"{h['max_function_length']} lines · deepest nesting: "
            f"{h['max_nesting']} levels"
        )
        lines.append("")

        if h["complex_functions"]:
            lines.append("**High-complexity functions** (cyclomatic ≥ 10 — "
                          "harder to test/modify):")
            for f in h["complex_functions"]:
                lines.append(f"- `{f['name']}()` — complexity {f['complexity']} "
                             f"(line {f['lineno']})")
            lines.append("")
        if h["long_functions"]:
            lines.append("**Long functions** (≥ 60 lines — consider splitting):")
            for f in h["long_functions"]:
                lines.append(f"- `{f['name']}()` — {f['length']} lines "
                             f"(line {f['lineno']})")
            lines.append("")
        if h["deep_functions"]:
            lines.append("**Deeply nested functions** (≥ 4 levels — hard to "
                          "follow):")
            for f in h["deep_functions"]:
                lines.append(f"- `{f['name']}()` — {f['nesting']} levels deep "
                             f"(line {f['lineno']})")
            lines.append("")
        if not (h["complex_functions"] or h["long_functions"]
                or h["deep_functions"]):
            lines.append("_No functions flagged for complexity, length, or "
                         "nesting._\n")

    lines.append("---\n")
    return lines


def _plain_title(name: str) -> str:
    """'11_generate_laydown_file.py' -> 'Step 11 — Generate Laydown File'."""
    m = re.match(r"^(\d+)[_-]?(.*)\.py$", name)
    if m:
        num, rest = m.group(1), m.group(2)
        words = rest.replace("_", " ").strip().title()
        return f"Step {num} — {words}" if words else f"Step {num}"
    return name.replace(".py", "").replace("_", " ").title()


def render_deliverable(scripts: list[ScriptInfo], folder: Path,
                       llm_used: bool, model: str, calls_made: int) -> str:
    """
    Onboarding deliverable: plain-language lead per step, technical detail
    tucked into collapsible <details> blocks. Aimed at a NEW ANALYST who
    knows the mission domain but does not read code.
    """
    L = []
    L.append(f"# {folder.name}: How This Pipeline Works\n")
    L.append("_An onboarding guide. Plain-language explanation up top; "
             "click **“Technical detail”** under any step to see the "
             "engineering specifics._\n")

    if not llm_used:
        L.append(
            "> ⚠️ **This guide needs the plain-language pass to be useful.** "
            "Re-run with `--deliverable --llm` (Ollama running) so each step "
            "gets a written, jargon-free explanation. Without it, only the "
            "technical detail is available.\n"
        )

    # ---- Start here: whole-pipeline orientation ----
    L.append("## Start here\n")
    n = len(scripts)
    first = scripts[0].name if scripts else "the first script"
    last = scripts[-1].name if scripts else "the last script"
    L.append(
        f"This pipeline is **{n} steps** that run in order. Each step reads "
        f"data files, does its part, and writes files the next step picks up — "
        f"like a relay. You start at `{first}` and finish at `{last}`. "
        f"You rarely run one step alone; they’re meant to run start to finish.\n"
    )
    L.append("**The steps at a glance:**\n")
    L.append("| # | Step | In one sentence |")
    L.append("|---|------|-----------------|")
    for s in scripts:
        if s.deliv_plain:
            # first sentence, but keep it meaningful (not just a 3-word clause)
            m = re.match(r"(.+?[.!?])(\s|$)", s.deliv_plain.strip())
            one_liner = m.group(1).strip() if m else s.deliv_plain.strip()
            if len(one_liner) < 25 and ". " in s.deliv_plain:
                one_liner = s.deliv_plain.split(". ", 1)[0].strip() + "."
        else:
            one_liner = infer_purpose_fallback(s)
        if len(one_liner) > 140:
            one_liner = one_liner[:137] + "..."
        L.append(f"| {s.name.split('_')[0]} | `{s.name}` | {one_liner} |")
    L.append("")

    # ---- Aggregated "things to watch" across the whole pipeline ----
    watch_items = []
    for s in scripts:
        for t in s.todos:
            watch_items.append((s.name, t))
    if watch_items:
        L.append("## Things to watch across the pipeline\n")
        L.append("_Open items and known issues the team has flagged in the "
                 "code. Worth knowing before you rely on the outputs._\n")
        for name, t in watch_items:
            L.append(f"- **{_plain_title(name)}:** {t}")
        L.append("")

    L.append("---\n")

    # ---- Per-step ----
    for s in scripts:
        L.append(f"## {_plain_title(s.name)}\n")
        L.append(f"<sub>`{s.name}`</sub>\n")

        # What it does + why it matters
        if s.deliv_plain:
            L.append(f"**What this step does.** {s.deliv_plain}\n")
        else:
            L.append(f"**What this step does.** _{infer_purpose_fallback(s)}_ "
                     "(run with `--deliverable --llm` for a written "
                     "explanation)\n")

        # In / out, plain language
        if s.deliv_inout:
            L.append(f"**What goes in and comes out.** {s.deliv_inout}\n")
        else:
            ins = len(s.files_read)
            outs = len(s.files_written)
            L.append(f"**What goes in and comes out.** Reads {ins} data "
                     f"file(s); produces {outs} file(s).\n")

        # Watch-outs
        if s.deliv_watch:
            L.append(f"**Watch out for.** {s.deliv_watch}\n")
        elif s.todos:
            L.append("**Watch out for.** "
                     + s.todos[0]
                     + (" …and more (see technical detail)."
                        if len(s.todos) > 1 else "")
                     + "\n")

        # Collapsible technical detail = the existing v8 section, verbatim
        tech = render_script_section(s)
        # drop the trailing '---' separator inside the details block
        if tech and tech[-1].strip() == "---":
            tech = tech[:-1]
        L.append("<details>")
        L.append("<summary><b>Technical detail</b> (for engineers — "
                 "click to expand)</summary>\n")
        L.extend(tech)
        L.append("</details>\n")
        L.append("---\n")

    return "\n".join(L)


def render_markdown(scripts: list[ScriptInfo], folder: Path,
                    llm_used: bool, model: str, calls_made: int) -> str:
    lines = []
    lines.append(f"# Per-Script Summaries: `{folder.name}`\n")
    lines.append(f"_{len(scripts)} scripts · five-part breakdown_\n")

    if llm_used:
        lines.append(
            f"> ✅ Local LLM prose enabled (`{model}` via Ollama). "
            f"{calls_made} script(s) summarized this run; the rest came from cache.\n"
        )
    else:
        lines.append(
            "> ℹ️ Structured extraction only. For written purpose/calculation/"
            "shaping prose, install Ollama, `ollama pull qwen2.5-coder:7b`, and "
            "re-run with `--llm`.\n"
        )

    # Contents
    lines.append("## Contents\n")
    for s in scripts:
        anchor = s.name.lower().replace(".", "").replace("_", "")
        lines.append(f"- [`{s.name}`](#{anchor})")
    lines.append("")

    for s in scripts:
        lines.extend(render_script_section(s))

    return "\n".join(lines)


# ---------- Main ----------

def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("folder", help="Folder containing pipeline .py files")
    parser.add_argument("-o", "--output", default="script_summaries.md")
    parser.add_argument("--llm", action="store_true",
                        help="Use a local Ollama model for prose (purpose, "
                             "calculation and shaping explanations)")
    parser.add_argument("--model", default="qwen2.5-coder:7b",
                        help="Ollama model name (default: qwen2.5-coder:7b)")
    parser.add_argument("--only", default=None, metavar="FILENAME",
                        help="Summarize ONLY this one script (fast — great for "
                             "testing). Accepts the filename, e.g. "
                             "11_generate_laydown_file.py")
    parser.add_argument("--limit", type=int, default=None, metavar="N",
                        help="Summarize only the first N scripts (in sorted "
                             "order). Useful to keep LLM runtime short.")
    parser.add_argument("--include-tools", action="store_true",
                        help="Also analyze analyzer/tooling files "
                             "(pipeline_analyzer_*.py, analyze_pipeline.py, "
                             "pyreverse.py). Excluded by default.")
    parser.add_argument("--deliverable", action="store_true",
                        help="Onboarding-deliverable mode: plain-language "
                             "explanation per step with technical detail in "
                             "collapsible sections. Aimed at new analysts who "
                             "know the domain, not the code. Best with --llm.")
    args = parser.parse_args()

    folder = Path(args.folder).resolve()
    if not folder.is_dir():
        raise SystemExit(f"Not a directory: {folder}")

    def _pipeline_sort_key(p: Path):
        # Sort by the leading number if present (so 2 < 11), else by name.
        m = re.match(r"^(\d+)", p.name)
        return (0, int(m.group(1)), p.name) if m else (1, 0, p.name)

    py_files = sorted(folder.glob("*.py"), key=_pipeline_sort_key)
    py_files = [p for p in py_files if p.name != Path(__file__).name]

    # Auto-exclude analyzer/tooling files unless --include-tools is set.
    # These are the documentation tools themselves, not pipeline scripts.
    if not args.include_tools:
        tool_patterns = (
            re.compile(r"^pipeline_analyzer.*\.py$"),
            re.compile(r"^analyze_pipeline\.py$"),
            re.compile(r"^pyreverse\.py$"),
        )
        before = len(py_files)
        py_files = [
            p for p in py_files
            if not any(pat.match(p.name) for pat in tool_patterns)
        ]
        excluded = before - len(py_files)
        if excluded:
            print(f"Excluded {excluded} analyzer/tool file(s) "
                  f"(use --include-tools to keep them).")

    if not py_files:
        raise SystemExit(f"No .py files found in {folder}")

    # --only: keep just the named script
    if args.only:
        target = args.only.strip()
        match = [p for p in py_files if p.name == target]
        if not match:
            available = ", ".join(p.name for p in py_files)
            raise SystemExit(
                f"--only '{target}' not found. Available: {available}"
            )
        py_files = match

    # --limit: first N (applied after --only, so --only always wins)
    if args.limit is not None and args.limit > 0:
        py_files = py_files[:args.limit]

    print(f"Analyzing {len(py_files)} script(s) ...")
    scripts = [analyze_script(p) for p in py_files]

    llm_used = False
    calls_made = 0
    if args.llm:
        if ollama_available():
            mode = "onboarding/deliverable" if args.deliverable else "technical"
            print(f"Ollama detected — running {mode} prose pass with "
                  f"'{args.model}'")
            print("(first run may be slow; results are cached for next time)")
            cache_path = Path(args.output).resolve().parent / ".summary_cache.json"
            calls_made = run_llm_pass(scripts, args.model, cache_path,
                                      deliverable=args.deliverable)
            llm_used = True
        else:
            print("⚠️  --llm requested but no Ollama server found at "
                  "localhost:11434.")
            print("    Producing the structured summary without prose. To enable:")
            print("    1) install Ollama  2) `ollama pull qwen2.5-coder:7b`  "
                  "3) make sure it's running  4) re-run with --llm")

    if args.deliverable:
        output = render_deliverable(scripts, folder, llm_used,
                                    args.model, calls_made)
    else:
        output = render_markdown(scripts, folder, llm_used,
                                 args.model, calls_made)
    out_path = Path(args.output).resolve()
    out_path.write_text(output, encoding="utf-8")

    print(f"\nWrote {out_path}")
    print(f"Summarized {len(scripts)} script(s).")
    if llm_used:
        print(f"LLM prose: {calls_made} fresh, {len(scripts) - calls_made} from cache.")


if __name__ == "__main__":
    main()
