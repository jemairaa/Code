"""
pipeline_analyzer_v7.py

Produces a DEEP PER-SCRIPT SUMMARY for each script in a numbered Python pipeline,
in a fixed five-part structure:

    1. Purpose         - one plain-English sentence (LLM-written if Ollama is up)
    2. Inputs          - files the script reads
    3. Outputs         - files the script writes
    4. Calculations    - the actual math: arithmetic on columns, np.where, trig,
                         groupby aggregations, unit conversions, .apply()
    5. Data shaping    - merges, filters, row add/drop, renames, missing-value
                         handling, reshapes (melt/pivot), formatting

Plus an "open items" box pulled from TODO/FIXME/"need to" comments.

DETERMINISTIC CORE + OPTIONAL LOCAL LLM
  The bulk of every summary is extracted deterministically by parsing the code -
  no model needed. If a local Ollama server is running, v7 additionally asks it
  to (a) write the one-sentence Purpose and (b) phrase the calculation and
  shaping findings as readable prose. If Ollama is NOT running, v7 still produces
  the full structured summary - it just skips the prose polish. Nothing ever
  leaves the machine: the only network call is to http://localhost:11434.

USAGE
    # structured summary only, no LLM
    python pipeline_analyzer_v7.py .\\ATHENA_Scripts -o script_summaries.md

    # with local Ollama prose polish (qwen2.5-coder:7b recommended)
    python pipeline_analyzer_v7.py .\\ATHENA_Scripts -o script_summaries.md --llm

    # pick a different local model
    python pipeline_analyzer_v7.py .\\ATHENA_Scripts -o script_summaries.md \\
        --llm --model qwen2.5-coder:3b

SETUP FOR THE --llm OPTION
    1. Install Ollama (https://ollama.com)
    2. ollama pull qwen2.5-coder:7b
    3. Make sure `ollama serve` is running (the desktop app does this for you)
    4. Run v7 with --llm

LLM results are cached in `.summary_cache.json` next to the output, keyed by a
hash of each script's contents, so re-runs only call the model for changed files.
"""

import argparse
import ast
import hashlib
import io
import json
import re
import tokenize
import urllib.request
import urllib.error
from pathlib import Path
from typing import Optional


READ_FUNCS = {
    "read_csv", "read_excel", "read_parquet", "read_json", "read_pickle",
    "read_feather", "read_html", "read_sql", "read_table", "read_file",
    "load", "loads", "load_workbook", "imread",
}
WRITE_FUNCS = {
    "to_csv", "to_excel", "to_parquet", "to_json", "to_pickle", "to_feather",
    "to_sql", "to_html", "to_file", "dump", "dumps", "save", "savefig",
    "imwrite", "write", "writelines",
}

# Data-shaping method names with friendly labels.
SHAPING_LABELS = {
    "merge": "merge/join", "join": "merge/join", "merge_asof": "merge/join",
    "concat": "concatenate (append rows/columns)",
    "rename": "rename columns", "drop": "drop columns/rows",
    "drop_duplicates": "drop duplicate rows", "dropna": "drop missing rows",
    "fillna": "fill missing values", "melt": "reshape: wide -> long (melt)",
    "pivot": "reshape: long -> wide (pivot)",
    "pivot_table": "reshape: pivot table", "sort_values": "sort rows",
    "reset_index": "reset index", "set_index": "set index",
    "groupby": "group-by aggregation", "isna": "missing-value filtering",
    "notna": "missing-value filtering", "isnull": "missing-value filtering",
    "notnull": "missing-value filtering", "isin": "membership filtering",
    "astype": "type conversion", "unique": "distinct values",
    "nunique": "count distinct",
}

# Known numeric constants worth explaining in calculations.
KNOWN_CONSTANTS = {
    "0.092903": "square feet -> square meters conversion",
    "10.7639": "square meters -> square feet conversion",
    "3.28084": "meters -> feet conversion",
    "0.3048": "feet -> meters conversion",
    "1609.34": "miles -> meters conversion",
    "1.60934": "miles -> kilometers conversion",
    "0.000621371": "meters -> miles conversion",
    "3.78541": "US gallons -> liters conversion",
    "0.264172": "liters -> US gallons conversion",
}


class ScriptInfo:
    def __init__(self, path: Path):
        self.path = path
        self.name = path.name
        self.source = ""
        self.line_count = 0
        self.docstring: Optional[str] = None
        self.constants: dict[str, str] = {}
        self.imports: list[str] = []
        self.files_read: list[str] = []
        self.files_written: list[str] = []
        self.functions: list[dict] = []
        self.section_comments: list[str] = []
        self.todos: list[str] = []
        # five-part content
        self.calculations: list[str] = []      # detected math, plain descriptions
        self.shaping: dict[str, int] = {}      # label -> count
        self.merges: list[str] = []            # human-readable merge descriptions
        # filled by LLM pass (optional)
        self.llm_purpose: str = ""
        self.llm_calc_prose: str = ""
        self.llm_shaping_prose: str = ""


# ---------- AST path-resolution engine (shared with v2-v6) ----------

def resolve_string(node, constants: dict[str, str]) -> Optional[str]:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    if isinstance(node, ast.Name):
        return constants.get(node.id)
    if isinstance(node, ast.JoinedStr):
        pieces = []
        for value in node.values:
            if isinstance(value, ast.Constant) and isinstance(value.value, str):
                pieces.append(value.value)
            elif isinstance(value, ast.FormattedValue):
                inner = resolve_string(value.value, constants)
                if inner is None:
                    return None
                pieces.append(inner)
            else:
                return None
        return "".join(pieces)
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Add):
        left = resolve_string(node.left, constants)
        right = resolve_string(node.right, constants)
        if left is not None and right is not None:
            return left + right
        return None
    return None


def looks_like_path(s: str) -> bool:
    if not s or len(s) > 300:
        return False
    if "/" in s or "\\" in s:
        return True
    return bool(re.search(r"\.\w{1,6}$", s))


def collect_constants(tree: ast.AST) -> dict[str, str]:
    constants: dict[str, str] = {}
    if not isinstance(tree, ast.Module):
        return constants
    for node in tree.body:
        if isinstance(node, ast.Assign):
            value = resolve_string(node.value, constants)
            if value is None:
                continue
            for target in node.targets:
                if isinstance(target, ast.Name):
                    constants[target.id] = value
    return constants


def collect_path_arg(call_node, constants: dict[str, str]) -> Optional[str]:
    if call_node.args:
        candidate = resolve_string(call_node.args[0], constants)
        if candidate and looks_like_path(candidate):
            return candidate
    for kw in call_node.keywords:
        if kw.arg in {"path", "filepath", "filename", "file", "io", "buf"}:
            candidate = resolve_string(kw.value, constants)
            if candidate and looks_like_path(candidate):
                return candidate
    return None


# ---------- Section comments + TODOs ----------

def extract_comments(source: str) -> tuple[list[str], list[str]]:
    comments: list[str] = []
    todos: list[str] = []
    todo_pattern = re.compile(r"\b(todo|fixme|hack|xxx|need to|figure out|not yet)\b", re.I)
    try:
        tokens = tokenize.generate_tokens(io.StringIO(source).readline)
        for tok in tokens:
            if tok.type == tokenize.COMMENT:
                start_col = tok.start[1]
                text = tok.string.lstrip("#").strip()
                if not text:
                    continue
                if todo_pattern.search(text):
                    todos.append(text)
                    continue
                if re.match(r"^[A-Za-z_][\w\.]*\s*[=\(\[]", text):
                    continue
                if re.match(r"^(import|from|def|class|return|if|for|while|print)\b", text):
                    continue
                if len(text) > 90:
                    continue
                if start_col <= 8:
                    comments.append(text)
    except (tokenize.TokenError, IndentationError):
        pass
    return comments, todos


# ---------- Merge description ----------

def describe_merge(call_node, constants: dict[str, str]) -> Optional[str]:
    func = call_node.func
    attr = func.attr if isinstance(func, ast.Attribute) else None
    if attr not in {"merge", "join", "merge_asof"}:
        return None
    left = ""
    if isinstance(func, ast.Attribute) and isinstance(func.value, ast.Name):
        left = func.value.id
    right = ""
    if call_node.args and isinstance(call_node.args[0], ast.Name):
        right = call_node.args[0].id
    on = None
    how = None
    for kw in call_node.keywords:
        if kw.arg in {"on", "left_on", "right_on"} and isinstance(kw.value, ast.Constant):
            on = kw.value.value
        if kw.arg == "how" and isinstance(kw.value, ast.Constant):
            how = kw.value.value
    parts = []
    if left and right:
        parts.append(f"`{left}` + `{right}`")
    elif right:
        parts.append(f"join with `{right}`")
    if on:
        parts.append(f"on `{on}`")
    if how:
        parts.append(f"({how})")
    return " ".join(parts) if parts else None


# ---------- Calculation detection ----------

def _unparse(node) -> str:
    try:
        return ast.unparse(node)
    except Exception:
        return "<expr>"


def _column_name(node) -> Optional[str]:
    """If node is df['col'] style subscript, return 'col'."""
    if isinstance(node, ast.Subscript):
        sl = node.slice
        if isinstance(sl, ast.Constant) and isinstance(sl.value, str):
            return sl.value
    return None


def _numeric_constants_in(node) -> list[str]:
    found = []
    for n in ast.walk(node):
        if isinstance(n, ast.Constant) and isinstance(n.value, (int, float)):
            found.append(repr(n.value))
    return found


def detect_calculations(tree: ast.AST) -> list[str]:
    """
    Walk the AST and surface mathematical operations in plain language:
      * arithmetic assigned to a dataframe column
      * np.where conditional replacement
      * np.sin / cos / radians (trig)
      * groupby().sum()/mean()/etc aggregations
      * .apply() with a function (row-wise calculation)
      * numeric constants that match known unit conversions
    """
    calcs: list[str] = []

    for node in ast.walk(tree):
        # --- arithmetic assigned to something (esp. a df column) ---
        if isinstance(node, ast.Assign) and isinstance(node.value, ast.BinOp):
            op = node.value.op
            op_name = {
                ast.Add: "+", ast.Sub: "-", ast.Mult: "×",
                ast.Div: "/", ast.Pow: "^", ast.Mod: "%",
            }.get(type(op))
            if op_name is None:
                continue
            # only care about numeric-ish arithmetic, skip string concat we can't tell
            target_desc = ""
            if node.targets:
                tgt = node.targets[0]
                col = _column_name(tgt)
                if col:
                    target_desc = f"`{col}` = "
                elif isinstance(tgt, ast.Name):
                    target_desc = f"`{tgt.id}` = "
            expr = _unparse(node.value)
            if len(expr) > 120:
                expr = expr[:117] + "..."
            line = f"computes {target_desc}`{expr}`"
            # annotate known unit-conversion constants
            consts = _numeric_constants_in(node.value)
            is_known_conversion = False
            for c in consts:
                key = c.rstrip("0").rstrip(".") if "." in c else c
                for known, meaning in KNOWN_CONSTANTS.items():
                    if c == known or key == known.rstrip("0").rstrip("."):
                        line += f" — {meaning}"
                        is_known_conversion = True
                        break
            # annotate percentage scaling ONLY for a literal fraction 0 < n < 1
            # (e.g. x * 0.9 -> "scales to 90%"), and only when the constant
            # isn't already a recognized unit conversion. Plain multipliers
            # like 80 are NOT percentages and get no annotation.
            if isinstance(op, ast.Mult) and not is_known_conversion:
                for side in (node.value.left, node.value.right):
                    if isinstance(side, ast.Constant) and isinstance(side.value, float):
                        v = side.value
                        if 0 < v < 1:
                            pct = round(v * 100, 4)
                            reduction = round(100 - pct, 4)
                            pct_s = f"{pct:g}"
                            red_s = f"{reduction:g}"
                            line += (f" — scales to {pct_s}% of the original "
                                     f"(a {red_s}% reduction)")
                            break
            calcs.append(line)

        # --- AugAssign (x += ...) ---
        elif isinstance(node, ast.AugAssign) and not isinstance(node.value, ast.Constant):
            op_name = {
                ast.Add: "+=", ast.Sub: "-=", ast.Mult: "×=", ast.Div: "/=",
            }.get(type(node.op))
            if op_name:
                col = _column_name(node.target)
                tgt = f"`{col}`" if col else (
                    f"`{node.target.id}`" if isinstance(node.target, ast.Name) else "value"
                )
                calcs.append(f"updates {tgt} with `{op_name} {_unparse(node.value)[:80]}`")

        # --- function calls: np.where, trig, groupby aggs, apply ---
        elif isinstance(node, ast.Call):
            func = node.func
            # np.where
            if isinstance(func, ast.Attribute) and func.attr == "where":
                cond = _unparse(node.args[0]) if node.args else ""
                if len(cond) > 80:
                    cond = cond[:77] + "..."
                calcs.append(f"conditional replace via `np.where({cond} ...)`")
            # trig / radians
            if isinstance(func, ast.Attribute) and func.attr in {"sin", "cos", "tan", "radians", "degrees"}:
                calcs.append(f"trigonometric: `{func.attr}(...)`")
            # groupby aggregation: look for .groupby(...).agg-ish chains
            if isinstance(func, ast.Attribute) and func.attr in {
                "sum", "mean", "median", "min", "max", "count", "std", "agg"
            }:
                # is the thing it's called on a groupby?
                inner = func.value
                chain = _unparse(inner)
                if "groupby" in chain:
                    calcs.append(f"aggregation: `{chain}.{func.attr}()`")
            # .apply with a function argument
            if isinstance(func, ast.Attribute) and func.attr == "apply":
                if node.args and isinstance(node.args[0], ast.Name):
                    calcs.append(f"row/column-wise calculation: `.apply({node.args[0].id})`")
                elif node.args and isinstance(node.args[0], ast.Lambda):
                    calcs.append("row/column-wise calculation: `.apply(lambda ...)`")
            # round()
            if isinstance(func, ast.Name) and func.id == "round":
                pass  # too noisy to list every round()

    # dedupe preserving order
    seen = set()
    return [c for c in calcs if not (c in seen or seen.add(c))]


# ---------- Whole-script analysis ----------

def analyze_script(path: Path) -> ScriptInfo:
    info = ScriptInfo(path)
    source = path.read_text(encoding="utf-8", errors="replace")
    info.source = source
    info.line_count = source.count("\n") + 1
    info.section_comments, info.todos = extract_comments(source)

    try:
        tree = ast.parse(source, filename=str(path))
    except SyntaxError as e:
        info.docstring = f"(could not parse: {e})"
        return info

    info.docstring = ast.get_docstring(tree)
    info.constants = collect_constants(tree)

    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                info.imports.append(alias.name.split(".")[0])
        elif isinstance(node, ast.ImportFrom):
            if node.module:
                info.imports.append(node.module.split(".")[0])
        elif isinstance(node, ast.Call):
            func = node.func
            attr = func.attr if isinstance(func, ast.Attribute) else None
            if attr in READ_FUNCS:
                resolved = collect_path_arg(node, info.constants)
                if resolved:
                    info.files_read.append(resolved)
            elif attr in WRITE_FUNCS:
                resolved = collect_path_arg(node, info.constants)
                if resolved:
                    info.files_written.append(resolved)
            if isinstance(func, ast.Name) and func.id == "open":
                resolved = collect_path_arg(node, info.constants)
                if resolved:
                    mode = "r"
                    if len(node.args) > 1:
                        m = resolve_string(node.args[1], info.constants)
                        if m:
                            mode = m
                    if any(c in mode for c in "wax"):
                        info.files_written.append(resolved)
                    else:
                        info.files_read.append(resolved)
            # shaping ops
            if attr in SHAPING_LABELS:
                label = SHAPING_LABELS[attr]
                info.shaping[label] = info.shaping.get(label, 0) + 1
            # merges
            mdesc = describe_merge(node, info.constants)
            if mdesc:
                info.merges.append(mdesc)

    # functions
    for node in tree.body:
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            info.functions.append({
                "name": node.name,
                "args": [a.arg for a in node.args.args],
                "docstring": ast.get_docstring(node),
            })

    # calculations
    info.calculations = detect_calculations(tree)

    def dedupe(seq):
        seen = set()
        return [x for x in seq if not (x in seen or seen.add(x))]

    info.imports = dedupe(info.imports)
    info.files_read = dedupe(info.files_read)
    info.files_written = dedupe(info.files_written)
    info.merges = dedupe(info.merges)
    return info


# ---------- Optional local LLM (Ollama) ----------

OLLAMA_URL = "http://localhost:11434/api/generate"


def ollama_available() -> bool:
    """Quick check: is a local Ollama server reachable?"""
    try:
        req = urllib.request.Request("http://localhost:11434/api/tags", method="GET")
        with urllib.request.urlopen(req, timeout=3) as resp:
            return resp.status == 200
    except Exception:
        return False


def ollama_generate(model: str, prompt: str, timeout: int = 120) -> Optional[str]:
    """Call the local Ollama server. Returns the response text, or None on failure."""
    payload = json.dumps({
        "model": model,
        "prompt": prompt,
        "stream": False,
        "options": {"temperature": 0.2},
    }).encode("utf-8")
    try:
        req = urllib.request.Request(
            OLLAMA_URL, data=payload,
            headers={"Content-Type": "application/json"}, method="POST",
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data.get("response", "").strip()
    except Exception:
        return None


def build_llm_prompt(info: ScriptInfo) -> str:
    """
    Build a grounded prompt: give the model the structured facts v7 already
    extracted PLUS the source, and ask for prose. Grounding in extracted facts
    keeps a small local model from hallucinating.
    """
    facts = []
    facts.append(f"Script name: {info.name}")
    if info.files_read:
        facts.append("Reads files: " + ", ".join(Path(f).name for f in info.files_read))
    if info.files_written:
        facts.append("Writes files: " + ", ".join(Path(f).name for f in info.files_written))
    if info.merges:
        facts.append("Merges/joins detected: " + "; ".join(info.merges))
    if info.calculations:
        facts.append("Calculations detected:\n  - " + "\n  - ".join(info.calculations))
    if info.shaping:
        facts.append("Shaping operations: " + ", ".join(
            f"{k} (x{v})" for k, v in sorted(info.shaping.items(), key=lambda kv: -kv[1])
        ))
    if info.section_comments:
        facts.append("Section comments in order:\n  - " + "\n  - ".join(info.section_comments))

    facts_block = "\n".join(facts)

    # Trim source so the prompt stays manageable for small local models
    src = info.source
    if len(src) > 8000:
        src = src[:8000] + "\n# ... (truncated for length) ..."

    return f"""You are documenting a Python data-pipeline script for a team.

Below are FACTS already extracted from the script by static analysis, followed
by the script's SOURCE CODE. Use the facts as ground truth; use the source for
detail. Do not invent file names or operations not present.

=== EXTRACTED FACTS ===
{facts_block}

=== SOURCE CODE ===
{src}

=== YOUR TASK ===
Respond in exactly this format, nothing else:

PURPOSE: <one plain-English sentence: what this script does and why it exists in the pipeline>

CALCULATIONS: <2-4 sentences explaining the mathematical calculations in plain English. If a numeric constant is a unit conversion, say so. For multiplication by a fraction (e.g. x * 0.9), describe it precisely as "scaled to 90% of the original" or "reduced by 10%" — never use the word "discount". If there are no real calculations, write "No significant mathematical calculations - this script is data shaping only.">

SHAPING: <2-4 sentences explaining how the script reshapes/combines/filters data, in plain English>
"""


def parse_llm_response(text: str) -> dict[str, str]:
    """Pull PURPOSE / CALCULATIONS / SHAPING sections out of the model's reply."""
    out = {"purpose": "", "calculations": "", "shaping": ""}
    if not text:
        return out
    # tolerant section parsing
    patterns = {
        "purpose": r"PURPOSE:\s*(.+?)(?=\n\s*(?:CALCULATIONS:|SHAPING:)|\Z)",
        "calculations": r"CALCULATIONS:\s*(.+?)(?=\n\s*(?:PURPOSE:|SHAPING:)|\Z)",
        "shaping": r"SHAPING:\s*(.+?)(?=\n\s*(?:PURPOSE:|CALCULATIONS:)|\Z)",
    }
    for key, pat in patterns.items():
        m = re.search(pat, text, re.S | re.I)
        if m:
            out[key] = " ".join(m.group(1).split())
    return out


# ---------- LLM cache ----------

def script_hash(info: ScriptInfo) -> str:
    return hashlib.sha256(info.source.encode("utf-8")).hexdigest()[:16]


def load_cache(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}


def save_cache(path: Path, cache: dict) -> None:
    try:
        path.write_text(json.dumps(cache, indent=2), encoding="utf-8")
    except Exception:
        pass


def run_llm_pass(scripts: list[ScriptInfo], model: str, cache_path: Path) -> int:
    """
    For each script, get LLM prose (from cache if the script is unchanged,
    otherwise by calling Ollama). Returns the number of scripts the model
    actually ran on (cache misses).
    """
    cache = load_cache(cache_path)
    calls_made = 0
    for info in scripts:
        h = script_hash(info)
        cache_key = f"{info.name}:{h}:{model}"
        if cache_key in cache:
            cached = cache[cache_key]
            info.llm_purpose = cached.get("purpose", "")
            info.llm_calc_prose = cached.get("calculations", "")
            info.llm_shaping_prose = cached.get("shaping", "")
            continue
        prompt = build_llm_prompt(info)
        print(f"  [LLM] summarizing {info.name} ...", flush=True)
        response = ollama_generate(model, prompt)
        calls_made += 1
        parsed = parse_llm_response(response or "")
        info.llm_purpose = parsed["purpose"]
        info.llm_calc_prose = parsed["calculations"]
        info.llm_shaping_prose = parsed["shaping"]
        cache[cache_key] = parsed
        save_cache(cache_path, cache)  # save incrementally so a crash doesn't lose work
    return calls_made


# ---------- Markdown rendering ----------

def infer_purpose_fallback(info: ScriptInfo) -> str:
    """Used when no LLM prose is available."""
    stem = re.sub(r"^\d+[_-]?", "", info.name.replace(".py", "")).replace("_", " ").strip()
    bits = [stem.capitalize() if stem else "Pipeline script"]
    if info.files_read:
        bits.append(f"reads {len(info.files_read)} file(s)")
    if info.files_written:
        bits.append(f"writes {len(info.files_written)} file(s)")
    return " — ".join(bits)


def render_script_section(info: ScriptInfo) -> list[str]:
    lines = []
    lines.append(f"## `{info.name}`\n")
    lines.append(f"_{info.line_count} lines · libraries: "
                 + (", ".join(f"`{i}`" for i in info.imports) or "none") + "_\n")

    # 1. Purpose
    lines.append("### 1. Purpose\n")
    if info.llm_purpose:
        lines.append(info.llm_purpose + "\n")
    elif info.docstring:
        lines.append(info.docstring.strip().split("\n")[0] + "\n")
    else:
        lines.append(f"_{infer_purpose_fallback(info)}_  ")
        lines.append("_(run with `--llm` for a written purpose)_\n")

    # 2. Inputs
    lines.append("### 2. Inputs (files read)\n")
    if info.files_read:
        for f in info.files_read:
            lines.append(f"- `{f}`")
    else:
        lines.append("- _None detected._")
    lines.append("")

    # 3. Outputs
    lines.append("### 3. Outputs (files written)\n")
    if info.files_written:
        for f in info.files_written:
            lines.append(f"- `{f}`")
    else:
        lines.append("- _None detected._")
    lines.append("")

    # 4. Calculations
    lines.append("### 4. Calculations (the math)\n")
    if info.llm_calc_prose:
        lines.append(info.llm_calc_prose + "\n")
    if info.calculations:
        lines.append("_Detected operations:_")
        for c in info.calculations:
            lines.append(f"- {c}")
        lines.append("")
    elif not info.llm_calc_prose:
        lines.append("_No mathematical calculations detected — this script is "
                     "data shaping only._\n")

    # 5. Data shaping
    lines.append("### 5. Data shaping\n")
    if info.llm_shaping_prose:
        lines.append(info.llm_shaping_prose + "\n")
    if info.merges:
        lines.append("**Joins / merges:**")
        for m in info.merges:
            lines.append(f"- {m}")
        lines.append("")
    if info.shaping:
        ops = sorted(info.shaping.items(), key=lambda kv: -kv[1])
        lines.append("**Operations:** "
                     + ", ".join(f"{label} ×{count}" for label, count in ops) + "\n")
    if info.section_comments:
        lines.append("**Step outline (from section comments):**")
        for i, c in enumerate(info.section_comments, 1):
            lines.append(f"{i}. {c}")
        lines.append("")
    if not (info.merges or info.shaping or info.section_comments or info.llm_shaping_prose):
        lines.append("_No data-shaping operations detected._\n")

    # Functions
    if info.functions:
        lines.append("**Functions defined:**")
        for fn in info.functions:
            sig = f"`{fn['name']}({', '.join(fn['args'])})`"
            doc = fn["docstring"].strip().split("\n")[0] if fn["docstring"] else ""
            lines.append(f"- {sig}" + (f" — {doc}" if doc else ""))
        lines.append("")

    # Open items
    if info.todos:
        lines.append("### ⚠️ Open items flagged in the code\n")
        for t in info.todos:
            lines.append(f"- {t}")
        lines.append("")

    lines.append("---\n")
    return lines


def render_markdown(scripts: list[ScriptInfo], folder: Path,
                    llm_used: bool, model: str, calls_made: int) -> str:
    lines = []
    lines.append(f"# Per-Script Summaries: `{folder.name}`\n")
    lines.append(f"_{len(scripts)} scripts · five-part breakdown_\n")

    if llm_used:
        lines.append(
            f"> ✅ Local LLM prose enabled (`{model}` via Ollama). "
            f"{calls_made} script(s) summarized this run; the rest came from cache.\n"
        )
    else:
        lines.append(
            "> ℹ️ Structured extraction only. For written purpose/calculation/"
            "shaping prose, install Ollama, `ollama pull qwen2.5-coder:7b`, and "
            "re-run with `--llm`.\n"
        )

    # Contents
    lines.append("## Contents\n")
    for s in scripts:
        anchor = s.name.lower().replace(".", "").replace("_", "")
        lines.append(f"- [`{s.name}`](#{anchor})")
    lines.append("")

    for s in scripts:
        lines.extend(render_script_section(s))

    return "\n".join(lines)


# ---------- Main ----------

def main():
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("folder", help="Folder containing pipeline .py files")
    parser.add_argument("-o", "--output", default="script_summaries.md")
    parser.add_argument("--llm", action="store_true",
                        help="Use a local Ollama model for prose (purpose, "
                             "calculation and shaping explanations)")
    parser.add_argument("--model", default="qwen2.5-coder:7b",
                        help="Ollama model name (default: qwen2.5-coder:7b)")
    args = parser.parse_args()

    folder = Path(args.folder).resolve()
    if not folder.is_dir():
        raise SystemExit(f"Not a directory: {folder}")

    py_files = sorted(folder.glob("*.py"))
    py_files = [p for p in py_files if p.name != Path(__file__).name]
    if not py_files:
        raise SystemExit(f"No .py files found in {folder}")

    print(f"Analyzing {len(py_files)} script(s) ...")
    scripts = [analyze_script(p) for p in py_files]

    llm_used = False
    calls_made = 0
    if args.llm:
        if ollama_available():
            print(f"Ollama detected — running prose pass with '{args.model}'")
            print("(first run may be slow; results are cached for next time)")
            cache_path = Path(args.output).resolve().parent / ".summary_cache.json"
            calls_made = run_llm_pass(scripts, args.model, cache_path)
            llm_used = True
        else:
            print("⚠️  --llm requested but no Ollama server found at "
                  "localhost:11434.")
            print("    Producing the structured summary without prose. To enable:")
            print("    1) install Ollama  2) `ollama pull qwen2.5-coder:7b`  "
                  "3) make sure it's running  4) re-run with --llm")

    output = render_markdown(scripts, folder, llm_used, args.model, calls_made)
    out_path = Path(args.output).resolve()
    out_path.write_text(output, encoding="utf-8")

    print(f"\nWrote {out_path}")
    print(f"Summarized {len(scripts)} script(s).")
    if llm_used:
        print(f"LLM prose: {calls_made} fresh, {len(scripts) - calls_made} from cache.")


if __name__ == "__main__":
    main()
